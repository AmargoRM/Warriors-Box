<?xml version="1.0" encoding="utf-8"?>
<!-- Copia automática de Android (si el usuario la tiene activada en su cuenta de Google). -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="photos/" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
