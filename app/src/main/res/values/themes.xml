<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WarriorsBox" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/wb_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.WarriorsBox.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wb_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.WarriorsBox</item>
    </style>
</resources>
